  <div class="container p-4 rounded-4 mt-4 dashboard-bg">

    <h3 class="mb-4 text-white">Dashboard de Desempenho</h3>

    <div class="row g-4">

      <div class="col-6 col-md-3">
        <div class="card dashcard" onclick="openCriados()">
          <div class="card-body text-center">
            <h6>Cursos Criados</h6>
            <h2 id="qtdCursos">0</h2>
          </div>
        </div>
      </div>

      <div class="col-6 col-md-3">
        <div class="card dashcard" onclick="openAlunos()">
          <div class="card-body text-center">
            <h6>Alunos em Curso</h6>
            <h2 id="qtdAlunos">0</h2>
          </div>
        </div>
      </div>

      <div class="col-6 col-md-3">
        <div class="card dashcard" onclick="openProvas()">
          <div class="card-body text-center">
            <h6>Provas Realizadas</h6>
            <h2 id="qtdProvas">0</h2>
          </div>
        </div>
      </div>

      <div class="col-6 col-md-3">
        <div class="card dashcard" onclick="openUsuarios()">
          <div class="card-body text-center">
            <h6>Número de Usuários</h6>
            <h2 id="qtdUsuarios">0</h2>
          </div>
        </div>
      </div>

      <div class="col-6 col-md-3">
        <a href="noticias.html" class="text-decoration-none">
          <div class="card dashcard">
            <div class="card-body text-center">
              <h6>Notícias</h6>
              <h2 id="qtdNoticias">0</h2>
            </div>
          </div>
        </a>
      </div>

      <div class="col-6 col-md-3">
        <div class="card dashcard">
          <div class="card-body text-center">
            <h6>Certificados</h6>
            <h2 id="qtdCertificados">0</h2>
          </div>
        </div>
      </div>

      <div class="col-6 col-md-3">
        <div class="card dashcard" onclick="openReports()">
          <div class="card-body text-center">
            <h6>Problemas Reportados</h6>
            <h2 id="qtdProblemas">0</h2>
          </div>
        </div>
      </div>

      <div class="col-6 col-md-3">
        <a href="vagas.html" class="text-decoration-none">
          <div class="card dashcard">
            <div class="card-body text-center">
              <h6>Vagas Criadas</h6>
              <h2 id="qtdVagas">0</h2>
            </div>
          </div>
        </a>
      </div>

    </div>



    <div class="row mt-4">

      <div class="col-md-4">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5>Desempenho das Provas</h5>
            <canvas id="graficoProvas" style="max-height:300px;"></canvas>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5>Aulas assistidas</h5>
            <canvas id="graficoAulas" style="max-height:300px;"></canvas>
          </div>
        </div>
      </div>

      <div class="col-md-4">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5>Usuarios Na plataforma</h5><a class="btn btn-primary btn-sm" href="cadastrar.html">Adicionar
              Usuarios</a>
            <canvas id="graficoAlunos" style="max-height:300px;"></canvas>
          </div>
        </div>
      </div>



    </div>

    <div class="row mt-4">

      <div class="col-md-6">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5>Ranking de Alunos</h5>

            <table class="table">
              <thead>
                <tr>
                  <th>Aluno</th>
                  <th>Pontos</th>
                </tr>
              </thead>
              <tbody id="TebelaRankingAlunos">

              </tbody>
            </table>

          </div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="card shadow-sm">
          <div class="card-body">
            <h5>Cursos Mais Acessados</h5>

            <ul class="list-group">
              <li class="list-group-item d-flex justify-content-between">
                Redes
                <span class="badge bg-primary">320 acessos</span>
              </li>
              <li class="list-group-item d-flex justify-content-between">
                Linux
                <span class="badge bg-primary">280 acessos</span>
              </li>
              <li class="list-group-item d-flex justify-content-between">
                Segurança
                <span class="badge bg-primary">190 acessos</span>
              </li>
            </ul>

          </div>
        </div>
      </div>

    </div>

  </div>