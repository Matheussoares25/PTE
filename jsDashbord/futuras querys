total de provas feitas pelo usuario dentro do curso

SELECT 
    up.id_user,
    t.id AS id_curso,
    COUNT(up.id) AS total_provas
FROM use_prova up
INNER JOIN aulas a ON up.id_prova = a.id
INNER JOIN modulos m ON a.id_modulo = m.id
INNER JOIN treinamentos t ON m.id_curso = t.id
WHERE up.id_user = 231   -- usuário
AND t.id = 1             -- curso
GROUP BY up.id_user, t.id; 


total de provas do curso

SELECT 
    COUNT(a.id) AS total_aulas_tipo_2
FROM modulos m
INNER JOIN aulas a ON a.id_modulo = m.id
WHERE m.id_curso = 1
AND a.tipo = 2;

